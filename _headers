/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://www.nooreharam.com https://img.youtube.com https://i.ytimg.com; frame-src 'self' https://maps.google.com https://www.google.com https://www.youtube.com https://youtube.com; media-src 'self' https://archive.org https://download.quranicaudio.com; connect-src 'self' https://open.er-api.com https://latest.currency-api.pages.dev https://cdn.jsdelivr.net https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://api.web3forms.com;

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/**/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/assets/css/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600
